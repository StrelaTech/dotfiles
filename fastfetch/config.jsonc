{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "title",
            "key": "  USER",
            "format": "{1}@{2}"
        },
        {
            "type": "os",
            "key": " 󰅶 OS",
            "format": "{1} {2}"
        },
        {
            "type": "kernel",
            "key": " 󰌽 KERNEL",
            "format": "{1}"
        },
	{
            "type": "product",
            "key": " 󰌢 MODEL",
            "format": "{1}"
        },
        {
            "type": "shell",
            "key": "  SHELL",
            "format": "{1} {2}"
        },
        {
            "type": "wm",
            "key": " 󰌆 WM",
            "format": "{1}"
        },
        {
            "type": "terminal",
            "key": "  TERM",
            "format": "{1}"
        },
        {
            "type": "displaymanager",
            "key": "   DM",
            "format": "{1}"
        },
        {
            "type": "cpu",
            "key": " 󰻠 CPU",
            "format": "{1}  {3}%",
            "bars": 10
        },
        {
            "type": "gpu",
            "key": " 󰢮 GPU",
            "format": "{1}  {2}%",
            "bars": 10
        },
        {
            "type": "memory",
            "key": " 󰍛 RAM",
            "format": "{1} / {2}  ({3}%)",
            "bars": 10
        },
        {
            "type": "disk",
            "key": " 󰋊 DISK",
            "format": "{1}  ({2} / {3})",
            "folders": ["/"]
        },
        {
            "type": "network",
            "key": " 󰤨 NET",
            "format": "{ip}"
        },
        {
            "type": "datetime",
            "key": "   DATE",
            "format": "{1}  {2}"
        },
        {
            "type": "locale",
            "key": " 󰗽 LOCALE",
            "format": "{1}"
        },
        {
            "type": "processes",
            "key": " 󰅂 PROCS",
            "format": "{1} running"
        },
        {
            "type": "break",
            "key": "────────────────────"
        },
        {
            "type": "colors",
            "key": " 󰨖 COLORS"
        }
    ]
}
